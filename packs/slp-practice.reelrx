        "this will fix",
        "will fix"
      ],
      "why": "Promises a result. Every child is different.",
      "try": "This is one way to give your child more chances to talk."
    },
    {
      "kind": "timeline",
      "match": [
        "in # weeks",
        "in # days",
        "in # months",
        "by next week",
        "overnight"
      ],
      "why": "A timeline is a promise you can't keep for every child.",
      "try": "Many kids make progress with practice. Every child's timeline is different."
    },
    {
      "kind": "cure",
      "match": [
        "cure",
        "cured",
        "cures",
        "fix stuttering",
        "fix a lisp",
        "fix your child's",
        "get rid of the stutter",
        "get rid of stuttering",
        "get rid of the lisp"
      ],
      "why": "'Cure' and 'fix' words promise an outcome, and can feel shaming to people who stutter.",
      "try": "Support your child's speech."
    },
    {
      "kind": "diagnosis",
      "match": [
        "they have apraxia",
        "your child has apraxia",
        "your child has autism",
        "they have autism",
        "means your child is",
        "is a sign of autism",
        "definitely has"
      ],
      "why": "Nobody can be diagnosed from a reel.",
      "try": "If you notice this, it's worth asking an SLP."
    },
    {
      "kind": "scope",
      "match": [
        "stop the medication",
        "stop the meds",
        "you don't need a doctor",
        "skip the pediatrician",
        "instead of the doctor"
      ],
      "why": "Medical advice is outside an SLP's lane.",
      "try": "Talk to your pediatrician."
    },
    {
      "kind": "testimonial",
      "match": [
        "best slp ever",
        "five stars",
        "5 stars",
        "my client said",
        "a parent told me",
        "one of my parents said"
      ],
      "why": "Client quotes and reviews need written permission, and can never be made up.",
      "try": "Cut it, or describe how you work instead."
    },
    {
      "kind": "privacy",
      "match": [
        "my client",
        "in session today",
        "today in session",
        "one of my kids",
        "my little guy",
        "my little girl",
        "my kiddo"
      ],
      "why": "Talking about a specific client can identify them, even without a name.",
      "try": "A lot of kids I see..."
    },
    {
      "kind": "absolute",
      "match": [
        "every child will",
        "all kids will",
        "all late talkers",
        "every late talker"
      ],
      "why": "'All' and 'every' claims leave out the kids they don't fit.",
      "try": "Many kids..."
    },
    {
      "kind": "superlative",
      "match": [
        "best speech therapist",
        "best slp in",
        "number one",
        "top rated",
        "top-rated"
      ],
      "why": "Superlatives you can't prove can read as misleading advertising.",
      "try": "Speech therapy for [who you help] in [your town]."
    },
    {
      "kind": "credential",
      "match": [
        "board certified",
        "certified in",
        "specialist in",
        "expert in"
      ],
      "why": "Name only credentials you hold, written the official way.",
      "try": "Use your exact credential, e.g. M.S., CCC-SLP."
    },
    {
      "kind": "causation",
      "match": [
        "screen time causes",
        "causes speech delay",
        "causes speech delays",
        "causes autism",
        "caused his delay",
        "caused her delay",
        "caused their delay"
      ],
      "why": "Cause-and-effect claims about delays and autism need strong evidence, and parents can hear blame.",
      "try": "Here's what can help..."
    },
    {
      "kind": "scope",
      "match": [
        "frenectomy will",
        "the release will fix",
        "cutting the tongue tie",
        "tongue tie causes",
        "clipping the tongue"
      ],
      "why": "Results after a tongue tie release vary, and the decision is medical.",
      "try": "If you're wondering about a tongue tie, ask your pediatrician or dentist. An SLP can look at how the tongue moves."
    },
    {
      "kind": "comparison",
      "match": [
        "faster than",
        "better than other",
        "other slps don't",
        "unlike other therapists"
      ],
      "why": "Comparing yourself to other clinicians can break ethics rules on how you represent services.",
      "try": "Here's how I work..."
    },
    {
      "kind": "insurance",
      "match": [
        "insurance covers",
        "insurance will pay",
        "covered by insurance",
        "will be reimbursed",
        "insurance will cover"
      ],
      "why": "Coverage depends on the plan. Promising it can backfire.",
      "try": "Many families use out-of-network benefits. Check your plan."
    },
    {
      "kind": "beforeafter",
      "match": [
        "before and after",
        "before after",
        "look at the difference",
        "look at them now"
      ],
      "why": "Before/after of a client is client footage: that's a red light.",
      "try": "Cut it. Show the strategy, not the client."
    },
    {
      "kind": "stats",
      "match": [
        "# percent of my clients",
        "#% of my clients",
        "all my clients",
        "every one of my clients"
      ],
      "why": "Outcome numbers about your clients are claims you'd need to back up, and they point at clients.",
      "try": "Many kids I work with..."
    },
    {
      "kind": "promise",
      "match": [
        "will catch up",
        "they'll catch up",
        "will grow out of it"
      ],
      "why": "Fine when you're busting the myth. Not fine as a promise.",
      "try": "Some kids catch up and some need support. That's why it's worth checking."
    },
    {
      "kind": "hype",
      "match": [
        "miracle",
        "magic trick",
        "the secret to",
        "game changer",
        "rewire the brain",
        "rewire their brain"
      ],
      "why": "Hype words oversell and can sound like a sales pitch for a health service.",
      "try": "A simple way to..."
    },
    {
      "kind": "promise",
      "match": [
        "you don't need therapy",
        "you don't need speech therapy",
        "no therapy needed",
        "skip therapy"
      ],
      "why": "Some kids do need therapy. Don't talk anyone out of help.",
      "try": "If you're worried, it's worth asking."
    },
    {
      "kind": "scope",
      "match": [
        "i diagnose autism",
        "i can diagnose autism",
        "i diagnosed",
        "i can tell if your child is autistic"
      ],
      "why": "An autism diagnosis is outside most SLPs' scope. Check your state.",
      "try": "I can screen and help you find the right next step."
    },
    {
      "kind": "scope",
      "match": [
        "supplement",
        "supplements",
        "essential oil",
        "essential oils",
        "melatonin",
        "stop the reflux"
      ],
      "why": "Supplements, medications and alternative treatments are outside an SLP's lane.",
      "try": "Talk to your pediatrician."
    }
  ],
  "stoplightExtras": [
    {
      "id": "materials",
      "text": "Therapy materials with a name, photo or handwriting are showing (artwork, name tags, picture schedules)",
      "level": "yellow",
      "fix": "Crop past them, cover them, or film before materials go out."
    },
    {
      "id": "aac",
      "text": "An AAC device or picture board that belongs to a client is in frame (their photos, name or custom buttons)",
      "level": "yellow",
      "fix": "Use a demo device or a blank board, or keep it out of the shot."
    },
    {
      "id": "telehealth",
      "text": "A video call screen is visible, even a thumbnail or frozen frame",
      "level": "yellow",
      "fix": "Close the call window before filming. If a client's face shows, it's red."
    },
    {
      "id": "audio",
      "text": "A child's voice can be heard in the background (waiting room, next room)",
      "level": "yellow",
      "fix": "Cut that part, or re-film when it's quiet."
    },
    {
      "id": "docs",
      "text": "Eval forms, test protocols, reports or session notes are on screen or on the table",
      "level": "yellow",
      "fix": "Clear the table and close the laptop. Blank protocols are fine; filled ones aren't."
    },
    {
      "id": "school",
      "text": "School-based: a district logo, classroom labels or student work is in frame",
      "level": "yellow",
      "fix": "Film somewhere neutral, and check your district's social media policy."
    }
  ],
  "reelTypes": [
    {
      "id": "tip",
      "name": "Talking-head tip",
      "length": "20-45s",
      "bestFor": "parents",
      "beats": [
        "Hook: the problem or the surprising part",
        "The tip, with one real-life example",
        "Why it works, in one sentence",
        "Close: what to do next"
      ]
    },
    {
      "id": "bts",
      "name": "Behind the scenes",
      "length": "8-20s",
      "bestFor": "trust",
      "beats": [
        "Hook text sets up the story",
        "3-6 quick clips, 1-3 seconds each",
        "Close text: a feeling or a line"
      ],
      "note": "No clients, ever. Check every clip's background."
    },
    {
      "id": "question",
      "name": "Parent question / myth vs. fact",
      "length": "30-60s",
      "bestFor": "parents searching for answers",
      "beats": [
        "Hook: the question in the parent's words",
        "Short answer first",
        "2-3 points, a text card for each",
        "Close: when to get help"
      ]
    },
    {
      "id": "dothis",
      "name": "Do this, not that",
      "length": "15-30s",
      "bestFor": "saves and shares",
      "beats": [
        "Hook: the thing most people do",
        "Not that: say or show it",
        "Do this: the swap",
        "Why, in one line",
        "Close: try it today"
      ]
    },
    {
      "id": "demo",
      "name": "Hands-only demo",
      "length": "20-40s",
      "bestFor": "showing a strategy",
      "beats": [
        "Hook: what you're about to show",
        "The toy or book",
        "Model it twice, slowly",
        "What to watch for",
        "Close: try it at home"
      ],
      "note": "Your hands and voice only. No child, ever. A stuffed animal can play the child."
    },
    {
      "id": "referral",
      "name": "For teachers & pediatricians",
      "length": "30-45s",
      "bestFor": "referral partners",
      "beats": [
        "Hook: who this is for",
        "2-3 signs worth a referral",
        "What happens after they refer",
        "Close: how to refer to you"
      ]
    }
  ],
  "hooks": [
    {
      "reelType": "tip",
      "audience": "parents",
      "text": "Quizzing your toddler isn't the same as teaching words."
    },
    {
      "reelType": "tip",
      "audience": "parents",
      "text": "Try this the next time they point and grunt."
    },
    {
      "reelType": "tip",
      "audience": "parents",
      "text": "Bath time is secretly great for talking. Here's why."
    },
    {
      "reelType": "tip",
      "audience": "parents",
      "text": "The car might be the best place to practice talking."
    },
    {
      "reelType": "tip",
      "audience": "parents",
      "text": "Say less, so your toddler can catch more."
    },
    {
      "reelType": "tip",
      "audience": "parents",
      "text": "Your child says one word. Add one more."
    },
    {
      "reelType": "tip",
      "audience": "parents",
      "text": "Wait five seconds. Then watch what happens."
    },
    {
      "reelType": "tip",
      "audience": "parents",
      "text": "Reading the whole book isn't the point."
    },
    {
      "reelType": "tip",
      "audience": "parents",
      "text": "If your child says 'tat' for 'cat,' watch this."
    },
    {
      "reelType": "tip",
      "audience": "parents",
      "text": "A snack-time trick for more chances to talk."
    },
    {
      "reelType": "tip",
      "audience": "clinicians",
      "text": "SLPs: your parent handouts are too long."
    },
    {
      "reelType": "tip",
      "audience": "clinicians",
      "text": "What I tell parents at the very first visit."
    },
    {
      "reelType": "bts",
      "audience": "parents",
      "text": "Setting up my therapy room before anyone gets here."
    },
    {
      "reelType": "bts",
      "audience": "parents",
      "text": "What I do after every session that nobody sees."
    },
    {
      "reelType": "bts",
      "audience": "parents",
      "text": "Everything in my therapy bag, and why."
    },
    {
      "reelType": "bts",
      "audience": "parents",
      "text": "What my family thinks I do all day vs. reality."
    },
    {
      "reelType": "bts",
      "audience": "clinicians",
      "text": "Prepping one toy five different ways."
    },
    {
      "reelType": "bts",
      "audience": "clinicians",
      "text": "The unglamorous side of running a private practice."
    },
    {
      "reelType": "bts",
      "audience": "parents",
      "text": "My favorite therapy toy costs under $10."
    },
    {
      "reelType": "question",
      "audience": "parents",
      "text": "'Should my 2-year-old be saying more words?'"
    },
    {
      "reelType": "question",
      "audience": "parents",
      "text": "Does screen time cause speech delays? What I tell parents."
    },
    {
      "reelType": "question",
      "audience": "parents",
      "text": "'He's a boy, he'll talk later.' Let's talk about that."
    },
    {
      "reelType": "question",
      "audience": "parents",
      "text": "3 signs it's worth getting a speech evaluation."
    },
    {
      "reelType": "question",
      "audience": "parents",
      "text": "Will two languages confuse my child?"
    },
    {
      "reelType": "question",
      "audience": "parents",
      "text": "Is it a lisp, or just a phase?"
    },
    {
      "reelType": "question",
      "audience": "parents",
      "text": "What actually happens at a speech evaluation?"
    },
    {
      "reelType": "question",
      "audience": "parents",
      "text": "Does a pacifier hurt speech? It depends."
    },
    {
      "reelType": "question",
      "audience": "parents",
      "text": "'Is my child's stuttering my fault?'"
    },
    {
      "reelType": "question",
      "audience": "parents",
      "text": "When should strangers understand what my child says?"
    },
    {
      "reelType": "dothis",
      "audience": "parents",
      "text": "Don't say 'say ___.' Try this instead."
    },
    {
      "reelType": "dothis",
      "audience": "parents",
      "text": "Not 'use your words.' Try this."
    },
    {
      "reelType": "dothis",
      "audience": "parents",
      "text": "Correcting their speech? Do this instead."
    },
    {
      "reelType": "dothis",
      "audience": "parents",
      "text": "Skip the yes/no question. Offer two choices."
    },
    {
      "reelType": "dothis",
      "audience": "parents",
      "text": "Don't finish their sentence. Do this instead."
    },
    {
      "reelType": "dothis",
      "audience": "parents",
      "text": "Skip the flashcards. Grab this instead."
    },
    {
      "reelType": "dothis",
      "audience": "parents",
      "text": "Instead of 'what color is it?' try this."
    },
    {
      "reelType": "dothis",
      "audience": "clinicians",
      "text": "SLPs: don't end sessions with 'any questions?'"
    },
    {
      "reelType": "demo",
      "audience": "parents",
      "text": "One toy car, ten words. Watch."
    },
    {
      "reelType": "demo",
      "audience": "parents",
      "text": "How I'd read this book with a late talker."
    },
    {
      "reelType": "demo",
      "audience": "parents",
      "text": "Bubbles, but make it speech practice."
    },
    {
      "reelType": "demo",
      "audience": "parents",
      "text": "Modeling AAC in 30 seconds. Watch my hands."
    },
    {
      "reelType": "demo",
      "audience": "parents",
      "text": "How to play 'ready, set... go' for speech."
    },
    {
      "reelType": "demo",
      "audience": "parents",
      "text": "One puzzle, three ways to build language."
    },
    {
      "reelType": "demo",
      "audience": "parents",
      "text": "What 'modeling' actually looks like at home."
    },
    {
      "reelType": "referral",
      "audience": "referral",
      "text": "Teachers: when a speech referral makes sense."
    },
    {
      "reelType": "referral",
      "audience": "referral",
      "text": "Pediatricians: speech signs worth a referral."
    },
    {
      "reelType": "referral",
      "audience": "referral",
      "text": "What happens after you refer a family to me."
    },
    {
      "reelType": "referral",
      "audience": "referral",
      "text": "Daycare teachers: what I wish you knew about late talkers."
    },
    {
      "reelType": "referral",
      "audience": "referral",
      "text": "'Wait and see' or 'let's check'? When to refer."
    },
    {
      "reelType": "referral",
      "audience": "clinicians",
      "text": "OTs and PTs: when to loop in an SLP."
    }
  ],
  "swaps": [
    {
      "term": "expressive language",
      "parent": "how your child puts words together"
    },
    {
      "term": "receptive language",
      "parent": "how your child understands what you say"
    },
    {
      "term": "articulation",
      "parent": "how clearly your child says sounds"
    },
    {
      "term": "phonological processes",
      "parent": "sound patterns kids use while they're learning (like 'tat' for 'cat')"
    },
    {
      "term": "disfluency",
      "parent": "stuttering, getting stuck on words"
    },
    {
      "term": "pragmatics",
      "parent": "using words with other people: taking turns, asking, joining in"
    },
    {
      "term": "AAC",
      "parent": "other ways to talk: pictures, a talker device, signs"
    },
    {
      "term": "modeling",
      "parent": "showing the words yourself"
    },
    {
      "term": "joint attention",
      "parent": "looking at the same thing together"
    },
    {
      "term": "intervention",
      "parent": "therapy, support"
    },
    {
      "term": "social language",
      "parent": "using words with other people"
    },
    {
      "term": "feeding therapy",
      "parent": "help with eating and trying new foods"
    },
    {
      "term": "oral motor",
      "parent": "how the mouth, lips and tongue move"
    },
    {
      "term": "expansion",
      "parent": "adding a word to what they said ('car' → 'red car')"
    },
    {
      "term": "sensory processing",
      "parent": "how your child handles sounds, touch and movement"
    },
    {
      "term": "fine motor",
      "parent": "hand skills: holding a crayon, buttons, snacks"
    },
    {
      "term": "gross motor",
      "parent": "big movements: crawling, walking, climbing"
    },
    {
      "term": "milestones",
      "parent": "what most kids are doing around this age"
    },
    {
      "term": "evaluation",
      "parent": "a visit where we find out what's going on"
    },
    {
      "term": "prognosis",
      "parent": "what we expect going forward"
    },
    {
      "term": "phoneme",
      "parent": "a speech sound"
    },
    {
      "term": "intelligibility",
      "parent": "how easy your child is to understand"
    },
    {
      "term": "stimulability",
      "parent": "whether your child can say the sound with help"
    },
    {
      "term": "motor planning",
      "parent": "how the brain tells the mouth what to do"
    },
    {
      "term": "apraxia",
      "parent": "trouble planning the mouth movements for speech"
    },
    {
      "term": "dysarthria",
      "parent": "weak or slow speech muscles"
    },
    {
      "term": "dysphagia",
      "parent": "trouble swallowing"
    },
    {
      "term": "aphasia",
      "parent": "trouble with language after a stroke or brain injury"
    },
    {
      "term": "echolalia",
      "parent": "repeating words or phrases they've heard"
    },
    {
      "term": "gestalt language processing",
      "parent": "learning language in chunks or phrases first"
    },
    {
      "term": "MLU",
      "parent": "how many words they put together"
    },
    {
      "term": "resonance",
      "parent": "how the voice sounds through the nose and mouth"
    },
    {
      "term": "hypernasality",
      "parent": "sounding like they're talking through their nose"
    },
    {
      "term": "IEP",
      "parent": "the school plan for your child's support"
    },
    {
      "term": "IFSP",
      "parent": "the early intervention plan for your family"
    },
    {
      "term": "early intervention",
      "parent": "your state's support for kids under 3"
    },
    {
      "term": "DLD",
      "parent": "a lasting difficulty learning and using language"
    },
    {
      "term": "phonemic awareness",
      "parent": "hearing the sounds inside words"
    },
    {
      "term": "decoding",
      "parent": "sounding out words"
    },
    {
      "term": "generalization",
      "parent": "using a new skill everywhere, not just in therapy"
    }
  ],
  "careLines": [
    "General info, not medical advice. Talk to your child's provider about your child.",
    "Every child is different. If you're worried, it's worth asking an SLP.",
    "This isn't a diagnosis. An evaluation is how we find out what's going on.",
    "Not a substitute for therapy. Just one thing to try at home."
  ],
